{
  "manifest_version": 3,
  "name": "WinUp — пароли",
  "version": "1.6.6",
  "description": "Пароли, коды 2FA и ключи доступа из WinUp. Связь с локальным приложением через Native Messaging.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background-v1.6.6.js"
    ]
  },
  "action": {
    "default_title": "WinUp — пароли",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "passkeys.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "passkey-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "autologin.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "winup@winup.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    }
  }
}